# MeshChat — ключи для продакшена (пока не нужны, демо работает без них)
# Скопируй в .env и заполни, когда будешь готов

# Cloudflare Workers (основной транспорт, обход DPI)
VITE_CF_ACCOUNT_ID=
VITE_CF_API_TOKEN=
VITE_CF_WORKER_URL=https://meshchat-relay.your-subdomain.workers.dev

# Fly.io (резервный транспорт)
VITE_FLYIO_APP_NAME=meshchat-relay
VITE_FLYIO_REGION=fra
VITE_FLYIO_URL=https://meshchat-relay.fly.dev

# WebRTC TURN (Cloudflare Calls / Twilio)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Tor / I2P (опционально)
VITE_TOR_SOCKS_PORT=9050
