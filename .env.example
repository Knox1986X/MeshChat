# Copy to .env or export before starting the relay.
# Every value is optional; the defaults are sane for a small private relay.

# Where to listen
MESHCHAT_PORT=8787
MESHCHAT_HOST=0.0.0.0

# Proof-of-work difficulty in leading zero bits (0 disables). 16 ≈ 65k hashes
# per message on the sender — enough to make spam expensive, invisible to users.
MESHCHAT_POW=16

# How long undelivered envelopes live on the relay.
MESHCHAT_TTL_DAYS=7

# On-disk journal (leave empty for memory-only storage).
MESHCHAT_DATA=./data

# Directory with the built UI (packages/relay/public after `npm run build`).
# MESHCHAT_STATIC=./packages/relay/public

# Requests per minute per IP for write endpoints.
MESHCHAT_RATE_LIMIT=240

# Relay name shown in /v1/health and in the app.
MESHCHAT_NAME=meshchat-relay

# NEVER enable in production: request lines contain IPs.
MESHCHAT_LOG=0
